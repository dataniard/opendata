# ==================== PostgreSQL ====================
POSTGRES_USER=opendata
POSTGRES_PASSWORD=changeme123!
POSTGRES_DB=hive_metastore

# ==================== MinIO ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme123!

# ==================== Superset ====================
SUPERSET_SECRET_KEY=your-secret-key-change-in-prod
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin123

# ==================== Spark ====================
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_DRIVER_MEMORY=2G
SPARK_EXECUTOR_MEMORY=2G

# ==================== S3 / MinIO ====================
AWS_S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme123!
AWS_S3_PATH_STYLE_ACCESS=true

# ==================== Iceberg ====================
ICEBERG_WAREHOUSE=s3a://iceberg-data
ICEBERG_CATALOG_TYPE=hive
ICEBERG_METASTORE_URI=thrift://hive-metastore:9083
