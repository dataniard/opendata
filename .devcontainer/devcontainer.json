{
  "name": "opendata-dev",
  "build": {
    "dockerFile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.extraPaths": ["/workspaces/opendata/scripts"]
      },
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.copilot"
      ]
    }
  },
  "forwardPorts": [
    5432,
    9000,
    9001,
    8080,
    8081,
    8085,
    8088,
    8888
  ],
  "postCreateCommand": "pip install --no-cache-dir pandas pyarrow pytest"
}
