# ==================== PostgreSQL ====================
POSTGRES_USER=opendata
POSTGRES_PASSWORD=changeme123!
POSTGRES_DB=hive_metastore

# ==================== MinIO ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme123!

# ==================== Superset ====================
SUPERSET_SECRET_KEY=your-secret-key-change-in-prod
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin123

# ==================== Spark ====================
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_DRIVER_MEMORY=2G
SPARK_EXECUTOR_MEMORY=2G

# ==================== S3 / MinIO ====================
AWS_S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme123!
AWS_S3_PATH_STYLE_ACCESS=true

# ==================== Iceberg ====================
ICEBERG_WAREHOUSE=s3a://iceberg-data
ICEBERG_CATALOG_TYPE=hive
ICEBERG_METASTORE_URI=thrift://hive-metastore:9083

# ==================== Airflow ====================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://opendata:changeme123!@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=airflow-fernet-key-1234
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__RBAC=True

# ==================== OpenMetadata (gobierno del dato) ====================
# Versión pineada (imágenes docker.getcollate.io/openmetadata/*).
# Requiere ~6 GiB RAM para el conjunto ES + server: NO apto para el
# perfil lite; solo se despliega con el docker-compose.yml completo.
OPENMETADATA_VERSION=1.12.14
OPENMETADATA_PORT=8585
OPENMETADATA_ADMIN_PORT=8586
OPENMETADATA_INGESTION_PORT=8090
# Rol/BBDD creados por config/postgres/init-openmetadata.sql en el
# primer arranque. Mantener sincronizado con ese fichero.
OPENMETADATA_DB=openmetadata_db
OPENMETADATA_DB_USER=openmetadata
OPENMETADATA_DB_PASSWORD=changeme-om123!
OPENMETADATA_INGESTION_DB=openmetadata_ingestion_db
OPENMETADATA_HEAP_OPTS=-Xmx1G -Xms1G
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HEAP=1G
